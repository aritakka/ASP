@model Store.Models.Order

@{
    ViewData["Title"] = "Запись на приём";
}

<h2 class="mb-3">Запись на приём</h2>

<div class="alert alert-info">
    Вы собираетесь записаться на стоматологическую услугу.
</div>

<form asp-action="CreateQuickOrder" method="post">

    <input type="hidden" name="productId" value="@ViewBag.ProductId" />
    <input type="hidden" name="quantity" value="1" />

    <button type="submit" class="btn btn-success">
        Подтвердить запись
    </button>

</form>

<a asp-controller="Products" asp-action="Index" class="btn btn-secondary mt-3">
    Назад к услугам
</a>