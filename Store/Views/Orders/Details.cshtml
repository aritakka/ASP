@model Store.Models.Order

@{
    ViewData["Title"] = "Запись";
}

<h2>Детали записи</h2>

<div class="card p-3">

    <p><strong>Дата:</strong> @Model.OrderDate</p>
    <p><strong>Сумма:</strong> @Model.TotalAmount ₽</p>
    <p><strong>Статус:</strong> @Model.Status</p>

    <p><strong>Клиент ID:</strong> @Model.CustomerId</p>

</div>

<a asp-action="Index" class="btn btn-secondary mt-3">
    Назад
</a>