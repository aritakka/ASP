@model IEnumerable<Store.Models.Product>

@{
    ViewData["Title"] = "Услуги";
}

<h1 class="mb-4">
    Услуги стоматологической клиники
</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Добавить услугу
        </a>
    </p>
}

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <img src="~/images/products/@(item.Id).jpg"
                     class="card-img-top"
                     style="height:250px; object-fit:cover;"
                     onerror="this.src='/images/no-image.jpg'" />

                <div class="card-body">

                    <h5 class="card-title">@item.Name</h5>

                    <p class="card-text">@item.Description</p>

                    <p>
                        <strong>Категория:</strong> @item.Category?.Name
                    </p>

                    <p>
                        <strong>Стоимость:</strong> @item.Price ₽
                    </p>

                </div>

                <div class="card-footer bg-white border-0">

                    <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary w-100 mb-2">
                        Подробнее
                    </a>

                    @if (!User.IsInRole("Admin"))
                    {
                        <!-- ВАЖНО: исправлено, больше НЕТ /Orders/Create (он ломал сайт) -->
                        <form asp-controller="Orders"
                              asp-action="CreateQuickOrder"
                              method="post">

                            <input type="hidden" name="productId" value="@item.Id" />
                            <input type="hidden" name="quantity" value="1" />

                            <button type="submit" class="btn btn-success w-100">
                                Записаться
                            </button>

                        </form>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="d-flex gap-2 mt-2">

                            <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning w-50">
                                Изменить
                            </a>

                            <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger w-50">
                                Удалить
                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>
    }

</div>