@{
    ViewData["Title"] = "Главная";
}

<div class="text-center mt-5">

    <h1 class="display-4">
        Стоматологическая клиника DentalClinic
    </h1>

    <p class="lead mt-4">
        Современные стоматологические услуги для взрослых и детей
    </p>

    <img src="~/images/clinic.jpg"
         class="img-fluid rounded shadow mt-4"
         style="max-height:450px;" />

    <div class="mt-5">

        <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary btn-lg">

            Перейти к услугам

        </a>

        @if (User.Identity.IsAuthenticated)
        {
            <a asp-controller="Orders"
                   asp-action="Index"
                   class="btn btn-success btn-lg ms-3">

                Мои записи

            </a>
        }

    </div>

</div>